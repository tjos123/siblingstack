# ── Supabase ──────────────────────────────────────────────────────────
# From: supabase.com → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # NEVER expose this client-side

# ── App URL (for unsubscribe links in emails) ─────────────────────────
NEXT_PUBLIC_APP_URL=www.siblingstack.com          # Change to your prod domain
APP_URL=https://www.siblingstack.com

# ── Android app (TWA) ─────────────────────────────────────────────────
# Used by /.well-known/assetlinks.json and the in-page download button.
NEXT_PUBLIC_ANDROID_PACKAGE_NAME=com.siblingstack.sprout
# SHA-256 of your signing certificate (comma-separate multiple keys).
#   keytool -list -v -keystore android.keystore -alias sprout
ANDROID_SHA256_CERT_FINGERPRINT=
# Where the built APK is hosted (falls back to /sprout-baby-tracker/sprout-baby-tracker.apk)
NEXT_PUBLIC_ANDROID_APK_URL=

# ── Email (Resend) ────────────────────────────────────────────────────
RESEND_API_KEY=re_...

# ── Waitlist security ─────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
UNSUBSCRIBE_SECRET=any-long-random-string
ADMIN_SECRET=any-different-long-random-string

# ── Paddle (dormant until subscription flag is re-enabled) ────────────
# From: Paddle dashboard → Developer Tools
PADDLE_ENVIRONMENT=sandbox                          # sandbox | production
PADDLE_API_KEY=pdl_api_...                          # server secret — NEVER expose client-side
PADDLE_WEBHOOK_SECRET=<your webhook signing secret>  # for /api/paddle/webhook signature checks
# Client-side (needed by the checkout overlay):
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=pdl_clt_...
NEXT_PUBLIC_PADDLE_MONTHLY_PRICE_ID=pri_...
NEXT_PUBLIC_PADDLE_ANNUAL_PRICE_ID=pri_...
